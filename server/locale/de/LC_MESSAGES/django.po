#: training/views.py:280 training/views.py:322
msgid "Unknown time zone"
msgstr "Unbekannte Zeitzone"

#: training/views.py:318
msgid "owner, distance_m and setup must be numbers"
msgstr "owner, distance_m und setup müssen Zahlen sein"

#: training/views.py:332
msgid "Use a date like 2026-10-25"
msgstr "Nutze ein Datum wie 2026-10-25"

#: training/views.py:372
msgid "The ranking is switched off for this team"
msgstr "Die Rangliste ist für dieses Team ausgeschaltet"

#: training/views.py:378
msgid "days and distance_m must be numbers"
msgstr "days und distance_m müssen Zahlen sein"

#: training/views.py:380
msgid "Between 1 and 365"
msgstr "Zwischen 1 und 365"

#: training/views.py:383
msgid "Give face and distance_m together"
msgstr "Gib face und distance_m zusammen an"

