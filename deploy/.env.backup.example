# Copy to deploy/.env.backup (it stays on the server, never in git) and fill in. SELFHOSTING.md, section 4.
# Where the encrypted backups go. A storage box over SFTP, for example:
RESTIC_REPOSITORY=sftp:USER@HOST:fletchr-backup
# The password that encrypts them. Without it the backups cannot be read: keep a copy of it away from the server.
RESTIC_PASSWORD=
