# Copy to deploy/.env and adjust.

# Local: plain HTTP on http://localhost:8080
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# Server: Caddy fetches a Let's Encrypt certificate for the domain
# SITE_ADDRESS=archery.example.de
# HTTP_PORT=80
# HTTPS_PORT=443


# Required. Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated, only for serving the app from another origin: the Vite dev server (http://localhost:5173)
# and the Android app (https://localhost; iOS would be capacitor://localhost)
# DJANGO_ALLOWED_HOSTS=archery.example.de
# DJANGO_CORS_ORIGINS=http://localhost:5173,https://localhost
