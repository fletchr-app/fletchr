# Copy to deploy/.env.prod on the server and fill in. Never commit the copy.

# Required. Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# The two local names are for the container's own health check.
DJANGO_ALLOWED_HOSTS=app.fletchr.de,127.0.0.1,localhost
# The Android app is served from https://localhost. When the website's join page goes live, add https://fletchr.de.
DJANGO_CORS_ORIGINS=https://localhost
# Needed for the admin login over HTTPS
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.fletchr.de

# Mail for the password reset. Without DJANGO_EMAIL_HOST the mails are only printed to the log.
# Use the mailbox for noreply@fletchr.de (Plesk: Mail). Port 465 with "ssl" works on the VPS; "starttls" (port 587) was not reachable.
DJANGO_EMAIL_HOST=mail.fletchr.de
DJANGO_EMAIL_PORT=465
DJANGO_EMAIL_SECURITY=ssl
DJANGO_EMAIL_USER=noreply@fletchr.de
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_FROM=Fletchr <noreply@fletchr.de>

# Where deploy/site.sh copies the website (docs/deploy.md, step 8): the document root of fletchr.de in Plesk.
# A folder inside the subscription, for example /var/www/vhosts/example.org/fletchr.de
SITE_ROOT=
