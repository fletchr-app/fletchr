# Copy to deploy/.env.prod on the server and fill in. Never commit the copy.

# Required. Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# The two local names are for the container's own health check.
DJANGO_ALLOWED_HOSTS=app.example.org,127.0.0.1,localhost
# The Android app is served from https://localhost. When the website's join page goes live, add https://example.org.
DJANGO_CORS_ORIGINS=https://localhost
# Sign in with Google. Only for the official server (the Google project is tied to the app's package and signing key);
# a self-hosted server leaves it unset and the endpoint answers 404. The web client ID, as in the app's VITE_GOOGLE_WEB_CLIENT_ID.
# DJANGO_GOOGLE_CLIENT_IDS=
# Needed for the admin login over HTTPS
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.org

# Mail for the password reset. Without DJANGO_EMAIL_HOST the mails are only printed to the log.
# The mailbox the mail is sent from. Port 465 with "ssl", or 587 with "starttls" if your server allows it (SELFHOSTING.md, section 6).
DJANGO_EMAIL_HOST=mail.example.org
DJANGO_EMAIL_PORT=465
DJANGO_EMAIL_SECURITY=ssl
DJANGO_EMAIL_USER=noreply@example.org
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_FROM=Fletchr <noreply@example.org>
# The website that opens links in the app: the reset mail gets the link <this>/reset/<code>. Leave it empty unless your app
# and website are set up for it (SELFHOSTING.md, section 7); the mail then carries the code only.
# DJANGO_SITE_URL=https://example.org

# Push notifications (SELFHOSTING.md, section 9): the Firebase service-account key you put in deploy/secrets/. Leave it unset
# and the server sends none. The app must be built for the same Firebase project.
# DJANGO_FCM_CREDENTIALS=/run/secrets/fcm.json

# Where deploy/site.sh copies the website (SELFHOSTING.md, section 7): the document root of your domain.
# With a panel such as Plesk a folder inside a subscription, for example /var/www/vhosts/example.org/example.org
SITE_ROOT=
