<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same for the cloud backup and for a transfer to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="media-queue" />
        <exclude domain="file" path="media-kept" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="media-queue" />
        <exclude domain="file" path="media-kept" />
    </device-transfer>
</data-extraction-rules>
