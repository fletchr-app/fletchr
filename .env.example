# Copy to .env (read by Vite at dev/build time).
# Default server address baked into the app; can be changed in the app's Settings.
# Phones on the same Wi-Fi need your PC's LAN IP, not localhost.
VITE_SERVER_URL=http://localhost:8080
# Sign in with Google: the web client ID of the Google Cloud project, the same value as DJANGO_GOOGLE_CLIENT_IDS on the
# official server. Leave it out for any other server (self-hosted servers do not offer Google sign-in).
# VITE_GOOGLE_WEB_CLIENT_ID=
# Push notifications: 1 when android/app/google-services.json (from your Firebase project) is in place. Without the file the app must not
# be built with it: asking Firebase to register crashes the app.
# VITE_PUSH=1
