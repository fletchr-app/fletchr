{
  "name": "fletchr",
  "version": "0.19.2",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Training log, coaching notes and evaluations for archers and coaches: Vue 3 web app and Capacitor phone app",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:api": "cd server && uv run python manage.py spectacular --file ../src/lib/openapi.yaml && cd .. && npx --yes openapi-typescript@7.13.0 src/lib/openapi.yaml -o src/lib/api-types.ts"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-social-login": "^8.7.5",
    "@ebarooni/capacitor-calendar": "8.10.0",
    "@ionic/vue": "^9.0.9",
    "@ionic/vue-router": "^9.0.9",
    "bootstrap": "^5.3.8",
    "ionicons": "^8.1.0",
    "openapi-fetch": "^0.17.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.3",
    "typescript": "~6.0.0",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.13"
  }
}
